module Turbopuffer
  module Internal
    module Transport
      class PooledNetRequester
        extend Turbopuffer::Internal::Util::SorbetRuntimeSupport

        type request =
          {
            method: Symbol,
            url: URI::Generic,
            headers: ::Hash[String, String],
            body: top,
            deadline: Float,
            timings: Turbopuffer::Internal::Transport::RequestObserver::Timings?
          }

        KEEP_ALIVE_TIMEOUT: 30

        DEFAULT_MAX_CONNECTIONS: Integer

        module ObservedConnection
          attr_accessor request_timings: Turbopuffer::Internal::Transport::RequestObserver::Timings?
        end

        class ObservedRequest
          attr_accessor request_timings: Turbopuffer::Internal::Transport::RequestObserver::Timings?
        end

        def self.connect: (
          cert_store: OpenSSL::X509::Store,
          url: URI::Generic
        ) -> top

        def self.calibrate_socket_timeout: (top conn, Float deadline) -> void

        def self.observe_connection: (
          top conn,
          Turbopuffer::Internal::Transport::RequestObserver::Timings? timings
        ) -> void

        def self.build_request: (
          Turbopuffer::Internal::Transport::PooledNetRequester::request request
        ) {
          (String arg0) -> void
        } -> [top, (^-> void)]

        private def with_pool: (
          URI::Generic url,
          deadline: Float
        ) {
          (top arg0) -> void
        } -> void

        def execute: (
          Turbopuffer::Internal::Transport::PooledNetRequester::request request
        ) -> [Integer, top, Enumerable[String]]

        def initialize: (?size: Integer) -> void
      end
    end
  end
end
